#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' file; do
  if ! git diff --quiet -- "$file"; then
    printf 'Cannot format partially staged file: %s\nStage the remaining changes, or stash the unstaged changes before committing.\n' "$file" >&2
    exit 1
  fi
  files+=("./$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if ((${#files[@]})); then
  ./node_modules/.bin/prettier --write --ignore-unknown -- "${files[@]}"
  git add -- "${files[@]}"
fi
bun run lint

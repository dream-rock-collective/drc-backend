POSTGRES_DB=collective_admin
POSTGRES_USER=foo
POSTGRES_PASSWORD=foo-bar-bazz
POSTGRES_PORT=5432
DATABASE_URL=postgres://foo:foo-bar-bazz@localhost:5432/collective_admin
REGISTRATION_SITE_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=foo-bar-bazz-qux
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:6942
STRIPE_MODE=CONNECTED
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ONCE=price_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_YEARLY=price_replace_me

# Local writes JSON only. Remote requires a dedicated clean checkout on the target branch.
SITE_PUBLISH_MODE=local
SITE_CHECKOUT_PATH=../registration-site
SITE_REPOSITORY=git@github.com:dream-rock-collective/registration-site.git
SITE_PUBLISH_BRANCH=main
SITE_GIT_NAME=Dream Rock Editor
SITE_GIT_EMAIL=editor@example.com
# SSH files: host paths for local Bun and for compose.site-ssh.yml mounts.
SITE_DEPLOY_KEY_PATH=
SITE_KNOWN_HOSTS_PATH=

POSTGRES_DB=collective_admin
POSTGRES_USER=foo
POSTGRES_PASSWORD=foo-bar-bazz
POSTGRES_PORT=5432

DATABASE_URL=postgres://foo:foo-bar-bazz@localhost:5432/collective_admin

REGISTRATION_SITE_ORIGIN=http://localhost:5173

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=foo-bar-bazz-qux

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:6942

STRIPE_MODE=CONNECTED
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ONCE=price_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_YEARLY=price_replace_me

# local writes JSON only; set remote to commit and push to SITE_REPOSITORY.
SITE_PUBLISH_MODE=local
# Required in BOTH modes: an existing checkout outside the backend repository.
# Remote example: /absolute/path/to/registration-site-publisher (dedicated clean clone).
# Clone it yourself, check out SITE_PUBLISH_BRANCH, and make fetch/push origin match
# SITE_REPOSITORY exactly. The publisher does not clone it automatically.
# Compose mounts this host path at /site and sets the container path automatically.
SITE_CHECKOUT_PATH=../registration-site
# Required in remote mode; these settings are ignored in local mode.
SITE_REPOSITORY=git@github.com:dream-rock-collective/registration-site.git
SITE_PUBLISH_BRANCH=main
# Commit author identity; replace the sample email with your publishing identity.
SITE_GIT_NAME=Dream Rock Editor
SITE_GIT_EMAIL=editor@example.com

# Required for the SSH repository URL above: absolute paths to a private deploy key
# with repository write access and a known_hosts file with verified Git host keys.
# Keep the private key outside both repositories. Example paths:
# SITE_DEPLOY_KEY_PATH=/absolute/path/to/registration-site-deploy-key
# SITE_KNOWN_HOSTS_PATH=/absolute/path/to/known_hosts
# These are host paths for Bun and compose.site-ssh.yml mounts. For Compose SSH use:
# docker compose -f docker-compose.yml -f compose.site-ssh.yml up -d --build
# HTTPS can leave both blank when Git credentials are provisioned on the host.
SITE_DEPLOY_KEY_PATH=
SITE_KNOWN_HOSTS_PATH=
